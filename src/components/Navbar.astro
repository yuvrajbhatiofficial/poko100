---
// Navbar.astro
---
<!-- Floating Glassy Navbar -->
<nav class="fixed top-4 left-4 md:top-6 md:left-6 z-40 bg-white/10 backdrop-blur-xl rounded-2xl md:rounded-3xl shadow-2xl border border-white/20 flex flex-col overflow-hidden">
  
  <!-- Logo Section -->
  <a href="/" class="flex flex-col items-center justify-center p-3 md:p-4 border-b border-white/10 hover:bg-white/5 transition-colors">
    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-white drop-shadow-[0_0_8px_rgba(255,255,255,0.5)] mb-1">
      <path d="M5 18v-4.656c0-.982.597-1.851 1.503-2.228L12 9l5.497 2.116A2.4 2.4 0 0 1 19 13.344V18"/>
      <path d="M12 9V5"/>
      <path d="M9 13v.01"/>
      <path d="M15 13v.01"/>
      <path d="M8 5h8"/>
    </svg>
    <span class="font-sans font-black text-sm md:text-base tracking-tighter text-white">poko<span class="text-purple-400">100</span></span>
  </a>

  <!-- Icons Section -->
  <div class="flex items-center">
    <!-- User Icon -->
    <a href="#" class="flex-1 flex justify-center items-center p-3 md:p-4 border-r border-white/10 text-white/70 hover:text-white hover:bg-white/5 transition-colors" aria-label="User Profile">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
    </a>
    
    <!-- Search Icon -->
    <button 
      id="search-trigger" 
      class="flex-1 flex justify-center items-center p-3 md:p-4 text-white/70 hover:text-white hover:bg-white/5 transition-colors focus:outline-none"
      aria-label="Search"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
    </button>
  </div>
</nav>

<script>
  document.getElementById('search-trigger')?.addEventListener('click', () => {
    window.dispatchEvent(new Event('open-search'));
  });
</script>
